# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# local Claude Code tooling state, not project source
/.claude/
# ...except the skills, which are project conventions rather than local
# settings. A skill that only exists on one machine cannot do its job: the
# whole point is that a fresh clone reviews UI the same way this one does.
!/.claude/skills/
!/.claude/skills/**

# agent instruction files — AGENTS.md is regenerated by `next dev` itself
# (see node_modules/next/dist/server/lib/generate-agent-files.js) and
# CLAUDE.md just points at it; neither is project source
/AGENTS.md
/CLAUDE.md

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright
/playwright-report/
/test-results/
/blob-report/

# scraper CI scratch files (see .github/workflows/update-perks.yml /
# scripts/classify-scrape-diff.ts) — generated fresh each run, never source
/pr-body.md
/scrape-diff-summary.md

# Local dev-server launcher generated by editor tooling — contains
# machine-specific absolute paths, so it is per-checkout, not shared.
dev-server-launch.cmd

# Marketing assets for the Steam guide — not part of the app, kept out of
# the repo on purpose.
docs/steam-guide/
# Same reason as the line above: promo renders are marketing assets for the
# store page, not part of the app. The .webm alone is 38 MB and a binary that
# large lives in every clone forever once it is committed.
docs/promo/
