# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# local Claude Code tooling state, not project source
/.claude/

# agent instruction files — AGENTS.md is regenerated by `next dev` itself
# (see node_modules/next/dist/server/lib/generate-agent-files.js) and
# CLAUDE.md just points at it; neither is project source
/AGENTS.md
/CLAUDE.md

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright
/playwright-report/
/test-results/
/blob-report/
